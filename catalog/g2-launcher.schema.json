{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GenomiskDiagnostik/g2-launcher/blob/main/catalog/g2-launcher.schema.json",
  "title": "G2 Launcher catalog",
  "type": "object",
  "required": ["schema_version", "apps"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string" },
    "updated": { "type": "string", "format": "date-time" },
    "support_url": { "type": "string", "format": "uri" },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "package_id", "version", "file_name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "package_id": { "type": "string", "minLength": 3 },
          "version": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "download_url": { "type": "string", "format": "uri" },
          "file_name": { "type": "string", "pattern": "\\.(zip|ehpk)$" },
          "package_root": { "type": "string" },
          "package_files": { "type": "array" },
          "package_chunks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "bundled_path": { "type": "string", "pattern": "^catalog-packages/" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "source_repository": { "type": "string", "format": "uri" },
          "author": { "type": "string" },
          "license": { "type": "string" },
          "min_launcher_version": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
